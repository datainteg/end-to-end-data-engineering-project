# Copy to .env, choose fresh LOCAL-ONLY passwords, then export for seed scripts.
POSTGRES_PASSWORD=replace-with-local-postgres-password
MONGO_PASSWORD=replace-with-local-mongodb-password
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ecommerce
PGUSER=demo
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=demo
# Cloud values: use IAM profiles/roles, never commit keys.
AWS_DEFAULT_REGION=ap-south-1
PROJECT_BUCKET=replace-with-private-bucket
POSTGRES_CONNECTION=replace-with-glue-connection
MONGO_CONNECTION=replace-with-glue-connection
STATE_MACHINE_ARN=replace-with-state-machine-arn
